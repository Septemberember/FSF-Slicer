include README.md LICENSE CHANGELOG.md CITATION.cff THIRD_PARTY_NOTICES.md
include requirements*.txt install.sh install.ps1
recursive-include docs *.md
recursive-include examples *.java *.yaml
recursive-include configs *.env
recursive-include scripts *.py *.sh *.ps1
recursive-include ci *.sh
recursive-include licenses *.txt
recursive-include tests *.py
recursive-include datasets *.java *.md
prune dist
prune validation
global-exclude *.pyc *.class .DS_Store
